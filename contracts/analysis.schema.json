{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:scamshield:analysis:v1",
  "title": "Analysis snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "rulesVersion",
    "band",
    "coverage",
    "indicators",
    "limitations"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "rulesVersion": {
      "type": "string",
      "minLength": 1
    },
    "band": {
      "enum": [
        "HIGH_CONCERN",
        "CAUTION",
        "NO_SIGNALS",
        "UNASSESSED"
      ]
    },
    "coverage": {
      "enum": [
        "SUPPORTED",
        "LIMITED",
        "UNSUPPORTED"
      ]
    },
    "indicators": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "category",
          "startUtf16",
          "endUtf16",
          "explanationKey"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "enum": [
              "SECRET_REQUEST",
              "INSTALL_REQUEST",
              "PRESSURE",
              "PAYMENT_REQUEST",
              "URL_STRUCTURE"
            ]
          },
          "startUtf16": {
            "type": "integer",
            "minimum": 0
          },
          "endUtf16": {
            "type": "integer",
            "minimum": 1
          },
          "explanationKey": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "coverage": {
            "const": "UNSUPPORTED"
          }
        }
      },
      "then": {
        "properties": {
          "band": {
            "const": "UNASSESSED"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "band": {
            "const": "NO_SIGNALS"
          }
        }
      },
      "then": {
        "properties": {
          "coverage": {
            "const": "SUPPORTED"
          },
          "indicators": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}

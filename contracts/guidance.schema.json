{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "version",
    "reviewedAt",
    "status",
    "actions"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "reviewedAt": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "enum": [
        "draft-requires-team-review-and-live-route-check",
        "reviewed"
      ]
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "liveCheckedAt": {
      "type": "string",
      "format": "date"
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "trigger",
          "priority",
          "title",
          "steps",
          "destinations",
          "sources"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z_]+$"
          },
          "trigger": {
            "enum": [
              "paid_yes",
              "secret_yes",
              "installed_yes",
              "always",
              "paid_not_yes",
              "any_unknown"
            ]
          },
          "priority": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "destinations": {
            "type": "array",
            "items": {
              "enum": [
                "tel:1930",
                "https://cybercrime.gov.in/",
                "https://sancharsaathi.gov.in/"
              ]
            }
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "editorialNote": {
            "type": "string"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "reviewed"
          }
        }
      },
      "then": {
        "required": [
          "reviewer",
          "liveCheckedAt"
        ]
      }
    }
  ]
}
